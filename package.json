{
  "name": "fc27-smart-sbc-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Local SBC optimizer for EA Sports FC 27 Ultimate Team. Analyses an imported club, solves SBC requirements around player protection rules, and proposes squads for manual completion.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/dashboard/server.js",
    "cli": "node dist/cli.js",
    "test": "node --test dist/tests/",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
