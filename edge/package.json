{
  "name": "fc27-sbc-edge",
  "version": "1.0.0",
  "private": true,
  "description": "FC 27 Smart SBC Assistant — Cloudflare Workers edition, behind Cloudflare Access",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "db:create": "wrangler d1 create fc27-sbc-assistant-club",
    "db:migrate:local": "wrangler d1 migrations apply fc27-sbc-assistant-club --local",
    "db:migrate:production": "wrangler d1 migrations apply fc27-sbc-assistant-club --env production --remote",
    "kv:create": "wrangler kv namespace create ACCESS_KEYS",
    "tail": "wrangler tail --env production",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "test:node": "vitest run",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "kv:create:preview": "wrangler kv namespace create ACCESS_KEYS --preview",
    "setup": "node scripts/setup.mjs",
    "setup:access": "node scripts/setup-access.mjs",
    "update": "node scripts/update.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.33",
    "@cloudflare/workers-types": "^4.20241205.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
