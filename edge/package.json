{
  "name": "fc27-sbc-edge",
  "version": "1.0.0",
  "private": true,
  "description": "FC 27 Smart SBC Assistant — Cloudflare Workers edition, behind Cloudflare Access",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "db:create": "wrangler d1 create fc27-sbc-db",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "kv:create": "wrangler kv namespace create CACHE",
    "tail": "wrangler tail --env production",
    "test": "vitest run",
    "types": "wrangler types",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.33",
    "@cloudflare/workers-types": "^4.20241205.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.95.0"
  }
}
